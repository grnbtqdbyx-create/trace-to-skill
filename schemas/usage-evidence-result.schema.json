{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grnbtqdbyx-create/trace-to-skill/schemas/usage-evidence-result.schema.json",
  "title": "trace-to-skill Codex usage evidence result",
  "type": "object",
  "required": ["generatedAt", "status", "inputs", "summary", "snapshots", "tokenUsage", "cacheRecords", "cacheCollapseEvents", "drainExperiments", "receipt", "findings", "checklist"],
  "additionalProperties": false,
  "properties": {
    "generatedAt": {
      "type": "string"
    },
    "status": {
      "enum": ["pass", "warn"]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "required": ["snapshots", "tokenUsageRecords", "usageLimitSignals", "resetDriftWindows", "highCachedInputRecords", "cacheRecords", "cacheCollapseEvents", "drainExperiments", "overheadSignals"],
      "additionalProperties": false,
      "properties": {
        "snapshots": {
          "type": "integer",
          "minimum": 0
        },
        "tokenUsageRecords": {
          "type": "integer",
          "minimum": 0
        },
        "usageLimitSignals": {
          "type": "integer",
          "minimum": 0
        },
        "resetDriftWindows": {
          "type": "integer",
          "minimum": 0
        },
        "highCachedInputRecords": {
          "type": "integer",
          "minimum": 0
        },
        "cacheRecords": {
          "type": "integer",
          "minimum": 0
        },
        "cacheCollapseEvents": {
          "type": "integer",
          "minimum": 0
        },
        "drainExperiments": {
          "type": "integer",
          "minimum": 0
        },
        "overheadSignals": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    },
    "tokenUsage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tokenUsage"
      }
    },
    "cacheRecords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cacheRecord"
      }
    },
    "cacheCollapseEvents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cacheCollapseEvent"
      }
    },
    "drainExperiments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/drainExperiment"
      }
    },
    "receipt": {
      "$ref": "#/$defs/receipt"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "required": ["source", "line", "window", "excerpt"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "window": {
          "type": "string"
        },
        "percent": {
          "type": "number"
        },
        "resetAt": {
          "type": "string"
        },
        "sampleTime": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "tokenUsage": {
      "type": "object",
      "required": ["source", "line", "excerpt"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "number"
        },
        "input": {
          "type": "number"
        },
        "cachedInput": {
          "type": "number"
        },
        "output": {
          "type": "number"
        },
        "reasoning": {
          "type": "number"
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "required": ["kind", "severity", "title", "why", "evidence", "nextStep"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "reset_timestamp_drift",
            "quota_percentage_jump",
            "usage_limit_with_remaining_quota",
            "high_cached_input",
            "prompt_cache_collapse",
            "high_total_tokens",
            "orchestration_overhead_signal",
            "rapid_quota_drain_experiment"
          ]
        },
        "severity": {
          "enum": ["medium", "high"]
        },
        "title": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "nextStep": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["file", "line", "excerpt"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": ["quotaWindows", "localTokenTotals", "drainExperiments", "overheadSignals", "cacheCollapseEvents", "suspectedCauses", "attribution"],
      "additionalProperties": false,
      "properties": {
        "quotaWindows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quotaWindow"
          }
        },
        "localTokenTotals": {
          "$ref": "#/$defs/localTokenTotals"
        },
        "drainExperiments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/drainExperiment"
          }
        },
        "overheadSignals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overheadSignal"
          }
        },
        "cacheCollapseEvents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cacheCollapseEvent"
          }
        },
        "suspectedCauses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attribution": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attribution"
          }
        }
      }
    },
    "attribution": {
      "type": "object",
      "required": ["bucket", "confidence", "signals", "evidence", "nextEvidence"],
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "type": "string",
          "enum": [
            "quota_window_accounting",
            "rapid_drain_repro",
            "prompt_cache_collapse",
            "large_cached_context_replay",
            "background_polling",
            "compaction_loop",
            "retry_or_tool_loop",
            "subagent_fanout",
            "idle_background_drain",
            "missing_evidence"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "signals": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "nextEvidence": {
          "type": "string"
        }
      }
    },
    "quotaWindow": {
      "type": "object",
      "required": ["window", "samples", "resetValues"],
      "additionalProperties": false,
      "properties": {
        "window": {
          "type": "string"
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "firstPercent": {
          "type": "number"
        },
        "lastPercent": {
          "type": "number"
        },
        "resetValues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "localTokenTotals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "number"
        },
        "input": {
          "type": "number"
        },
        "cachedInput": {
          "type": "number"
        },
        "output": {
          "type": "number"
        },
        "reasoning": {
          "type": "number"
        }
      }
    },
    "drainExperiment": {
      "type": "object",
      "required": ["source", "line", "window", "excerpt"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "window": {
          "type": "string"
        },
        "percentDelta": {
          "type": "number"
        },
        "credits": {
          "type": "number"
        },
        "promptCount": {
          "type": "number"
        },
        "durationMinutes": {
          "type": "number"
        },
        "model": {
          "type": "string"
        },
        "plan": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "cacheRecord": {
      "type": "object",
      "required": ["source", "line", "excerpt"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "inputTokens": {
          "type": "number"
        },
        "cachedInputTokens": {
          "type": "number"
        },
        "cacheHitPercent": {
          "type": "number"
        },
        "promptCacheKey": {
          "type": "string"
        },
        "responseId": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "cacheCollapseEvent": {
      "type": "object",
      "required": ["source", "line", "previousLine", "cachedInputTokens", "previousCachedInputTokens", "dropPercent", "excerpt"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "previousLine": {
          "type": "integer",
          "minimum": 1
        },
        "inputTokens": {
          "type": "number"
        },
        "cachedInputTokens": {
          "type": "number"
        },
        "previousCachedInputTokens": {
          "type": "number"
        },
        "dropPercent": {
          "type": "number"
        },
        "promptCacheKey": {
          "type": "string"
        },
        "responseId": {
          "type": "string"
        },
        "previousResponseId": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "overheadSignal": {
      "type": "object",
      "required": ["kind", "source", "line", "excerpt"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["background_polling", "compaction_loop", "retry_or_tool_loop", "subagent_fanout", "idle_drain"]
        },
        "source": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt": {
          "type": "string"
        }
      }
    }
  }
}
