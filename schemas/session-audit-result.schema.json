{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grnbtqdbyx-create/trace-to-skill/schemas/session-audit-result.schema.json",
  "title": "trace-to-skill Codex session audit result",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "root", "status", "thresholds", "summary", "files", "threads", "subagentSignals", "stateFiles", "findings"],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "root": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "warn", "fail"]
    },
    "thresholds": {
      "$ref": "#/$defs/thresholds"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/thread"
      }
    },
    "subagentSignals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subagentSignal"
      }
    },
    "stateFiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stateFile"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["largeFileBytes", "hugeLineBytes"],
      "properties": {
        "largeFileBytes": {
          "type": "integer",
          "minimum": 1
        },
        "hugeLineBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonlFiles", "totalBytes", "largeFiles", "hugeLineFiles", "parseErrorFiles", "rolloutThreads", "indexedThreads", "unindexedRolloutThreads", "bloatedIndexTitles", "subagentSignalFiles", "subagentSignals", "projectRoots"],
      "properties": {
        "jsonlFiles": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "largeFiles": {
          "type": "integer",
          "minimum": 0
        },
        "hugeLineFiles": {
          "type": "integer",
          "minimum": 0
        },
        "parseErrorFiles": {
          "type": "integer",
          "minimum": 0
        },
        "sessionIndexLines": {
          "type": "integer",
          "minimum": 0
        },
        "rolloutFiles": {
          "type": "integer",
          "minimum": 0
        },
        "rolloutThreads": {
          "type": "integer",
          "minimum": 0
        },
        "indexedThreads": {
          "type": "integer",
          "minimum": 0
        },
        "unindexedRolloutThreads": {
          "type": "integer",
          "minimum": 0
        },
        "bloatedIndexTitles": {
          "type": "integer",
          "minimum": 0
        },
        "subagentSignalFiles": {
          "type": "integer",
          "minimum": 0
        },
        "subagentSignals": {
          "type": "integer",
          "minimum": 0
        },
        "projectRoots": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sizeBytes", "lineCount", "largestLineBytes", "jsonParseErrors", "recordTypes", "signalCounts"],
      "properties": {
        "path": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "lineCount": {
          "type": "integer",
          "minimum": 0
        },
        "largestLineBytes": {
          "type": "integer",
          "minimum": 0
        },
        "jsonParseErrors": {
          "type": "integer",
          "minimum": 0
        },
        "recordTypes": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "signalCounts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "session": {
          "$ref": "#/$defs/threadMetadata"
        }
      }
    },
    "threadMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "cwdBasename": {
          "type": "string"
        },
        "cwdHash": {
          "type": "string"
        },
        "originator": {
          "type": "string"
        },
        "cliVersion": {
          "type": "string"
        },
        "sourceKind": {
          "type": "string"
        }
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "indexed", "recoverCommand"],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "indexed": {
          "type": "boolean"
        },
        "indexTitle": {
          "type": "string"
        },
        "indexTitleBytes": {
          "type": "integer",
          "minimum": 0
        },
        "indexTitleSignals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "indexUpdatedAt": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "cwdBasename": {
          "type": "string"
        },
        "cwdHash": {
          "type": "string"
        },
        "originator": {
          "type": "string"
        },
        "cliVersion": {
          "type": "string"
        },
        "sourceKind": {
          "type": "string"
        },
        "recoverCommand": {
          "type": "string"
        }
      }
    },
    "subagentSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "count", "note"],
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "spawn_agent",
            "wait_agent",
            "close_agent",
            "thread_spawn_edges",
            "agent_thread_limit",
            "stale_subagent_ui",
            "child_recent_thread",
            "compaction_lost_subagents",
            "no_agents_completed",
            "subagent_notification"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "stateFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sizeBytes", "present"],
      "properties": {
        "path": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "present": {
          "type": "boolean"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "kind", "message"],
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["warning", "error"]
        },
        "kind": {
          "type": "string",
          "enum": ["large_rollout", "huge_jsonl_line", "json_parse_error", "short_session_index", "unindexed_rollout_thread", "bloated_index_title", "subagent_lifecycle_signal", "state_file_present"]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
