{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grnbtqdbyx-create/trace-to-skill/schemas/process-audit-result.schema.json",
  "title": "trace-to-skill Codex process audit result",
  "type": "object",
  "required": ["generatedAt", "status", "inputs", "summary", "signals", "findings", "checklist"],
  "additionalProperties": false,
  "properties": {
    "generatedAt": {
      "type": "string"
    },
    "status": {
      "enum": ["pass", "warn"]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "required": ["signals", "powershellCimCommands", "highCpuProcesses", "staleProcessManagerSignals", "codexHelperSignals"],
      "additionalProperties": false,
      "properties": {
        "signals": {
          "type": "integer",
          "minimum": 0
        },
        "powershellCimCommands": {
          "type": "integer",
          "minimum": 0
        },
        "highCpuProcesses": {
          "type": "integer",
          "minimum": 0
        },
        "staleProcessManagerSignals": {
          "type": "integer",
          "minimum": 0
        },
        "codexHelperSignals": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/signal"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "kind": {
      "enum": ["powershell_cim_polling", "high_cpu_process", "stale_process_manager_entries", "codex_helper_runaway"]
    },
    "signal": {
      "type": "object",
      "required": ["kind", "source", "line", "excerpt"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "source": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "processName": {
          "type": "string"
        },
        "pid": {
          "type": "number"
        },
        "cpuPercent": {
          "type": "number"
        },
        "cpuSeconds": {
          "type": "number"
        },
        "ratePerSecond": {
          "type": "number"
        },
        "count": {
          "type": "number"
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "required": ["kind", "severity", "title", "why", "evidence", "nextStep"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "severity": {
          "enum": ["medium", "high"]
        },
        "title": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "nextStep": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["file", "line", "excerpt"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt": {
          "type": "string"
        }
      }
    }
  }
}
